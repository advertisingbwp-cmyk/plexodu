# =============================================================================
# Plexudo Backend Environment Variables
# =============================================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/plexudo
TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/plexudo_test

# ---- Sessions & Security ----
SECRET_KEY=change-me-to-a-random-64-char-hex-string
SESSION_COOKIE_NAME=plexudo_session
SESSION_MAX_AGE_DAYS=30
CSRF_SECRET=change-me-to-another-random-64-char-hex-string
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64-encoded
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Google OAuth (Connect YouTube Flow Only — NOT for Plexudo Login) ----
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
YOUTUBE_CONNECT_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# ---- Groq AI Engine ----
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=20.0

# ---- Transactional Email Delivery (smtp, sendgrid, resend, console) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@plexudo.com
EMAIL_FROM_NAME=Plexudo

# ---- Application URLs ----
FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=https://plexudo.vercel.app
ENVIRONMENT=development

# ---- Rate Limiting ----
REDIS_URL=redis://localhost:6379/0

# ---- Dynamic Per-Tool Credit Costs ----
TOOL_CREDIT_COST_VIDEO_ANALYZER=1
TOOL_CREDIT_COST_KEYWORD_TOOL=1
TOOL_CREDIT_COST_TREND_ANALYZER=1
TOOL_CREDIT_COST_COMPETITOR_ANALYSIS=1
TOOL_CREDIT_COST_AI_ASSISTANT=1
TOOL_CREDIT_COST_SEO_SCORE=1
