# SMTAS - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit real secret values to version control.

# Core AI Credentials
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google & YouTube Data API v3 Credentials
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google OAuth Redirect URIs
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/channel-seo/auth/callback
YOUTUBE_CALLBACK_URL=http://127.0.0.1:8000/api/v1/youtube/callback

# Server & Session Settings
SECRET_KEY=
PORT=5000
HOST=127.0.0.1
FLASK_ENV=development
