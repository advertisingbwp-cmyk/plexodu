# Plexudo - Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit real secret values to version control.

# Core AI Credentials (Backend-only)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# YouTube Data API v3 Credentials (Backend-only)
YOUTUBE_API_KEY=

# Database Persistence
DATABASE_URL=sqlite:///backend/smtas.db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=https://plexudo.vercel.app,http://localhost:3000,http://127.0.0.1:5000

# Server & Security Settings
SECRET_KEY=
PORT=5000
HOST=127.0.0.1
FLASK_ENV=production
