{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(blog.*|youtube-.*|privacy|terms|sitemap.xml|robots.txt|favicon.ico)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|blog|youtube-|privacy|terms|sitemap.xml|robots.txt|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
