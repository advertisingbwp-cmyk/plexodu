{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/favicon.ico",
      "dest": "/frontend/favicon.ico"
    },
    {
      "src": "/favicon.svg",
      "dest": "/frontend/favicon.svg"
    },
    {
      "src": "/favicon.png",
      "dest": "/frontend/favicon.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "/frontend/apple-touch-icon.png"
    },
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "/tools/?",
      "dest": "/frontend/tools/index.html"
    },
    {
      "src": "/tools/trend-analyzer/?",
      "dest": "/frontend/tools/trend-analyzer.html"
    },
    {
      "src": "/tools/video-analyzer/?",
      "dest": "/frontend/tools/video-analyzer.html"
    },
    {
      "src": "/tools/keyword-tool/?",
      "dest": "/frontend/tools/keyword-tool.html"
    },
    {
      "src": "/tools/competitor-audit/?",
      "dest": "/frontend/tools/competitor-audit.html"
    },
    {
      "src": "/tools/ai-strategist/?",
      "dest": "/frontend/tools/ai-strategist.html"
    },
    {
      "src": "/tools/([^/]+)/?",
      "dest": "/frontend/tools/$1.html"
    },
    {
      "src": "/terms",
      "dest": "/frontend/terms.html"
    },
    {
      "src": "/terms.html",
      "dest": "/frontend/terms.html"
    },
    {
      "src": "/privacy",
      "dest": "/frontend/privacy.html"
    },
    {
      "src": "/privacy.html",
      "dest": "/frontend/privacy.html"
    },
    {
      "src": "/ads.txt",
      "dest": "/frontend/ads.txt"
    },
    {
      "src": "/robots.txt",
      "dest": "/frontend/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/frontend/sitemap.xml"
    },
    {
      "src": "/blog/",
      "dest": "/frontend/blog/index.html"
    },
    {
      "src": "/blog",
      "status": 301,
      "headers": { "Location": "/blog/" }
    },
    {
      "src": "/blog/([^/]+)/",
      "dest": "/frontend/blog/$1/index.html"
    },
    {
      "src": "/blog/([^/]+)",
      "status": 301,
      "headers": { "Location": "/blog/$1/" }
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
